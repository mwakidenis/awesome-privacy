---
import Layout from '@layouts/Layout.astro';
import Main from '@components/scafold/MainCard.astro';
import { apiBase } from '@utils/api-config';

const examples = [
	{
		label: 'Browse',
		path: '/v1/categories',
		response: `{
  "data": [
    {
      "name": "Essentials",
      "slug": "essentials",
      "sections": [
        { "name": "Password Managers", "slug": "password-managers" },
        { "name": "Browsers", "slug": "browsers" },
        …
      ]
    },
    …
  ]
}`,
	},
	{
		label: 'Lookup',
		path: '/v1/services/bitwarden',
		response: `{
  "data": {
    "name": "Bitwarden",
    "url": "https://bitwarden.com",
    "category": "Essentials",
    "section": "Password Managers",
    "github": "bitwarden/server"
  }
}`,
	},
	{
		label: 'Search',
		path: '/v1/search?q=vpn',
		response: `{
  "data": [
    {
      "slug": "ovpn",
      "name": "OVPN",
      "section": "Virtual Private Networks",
      "score": 15.29
    }
  ],
  "pagination": { "page": 1, "limit": 20, "total": 14 }
}`,
	},
];

const endpoints = [
	{
		title: 'Listing data',
		routes: [
			['/v1/services', 'Every service, paginated'],
			['/v1/services/{slug}', 'A single service'],
			['/v1/categories', 'All categories'],
			['/v1/categories/{slug}', 'One category and its sections'],
			['/v1/sections/{slug}', 'One section and its services'],
			['/v1/search', 'Ranked search across every listing'],
			['/v1/stats', 'Totals for the whole list'],
			['/v1/health', 'Uptime and data freshness'],
		],
	},
	{
		title: 'Enrichment',
		routes: [
			['/v1/enrich/privacy/{tosdrId}', 'ToS;DR rating and policy points'],
			['/v1/enrich/security/{owner}/{repo}', 'OSSF scorecard and advisories'],
			['/v1/enrich/github/{owner}/{repo}', 'Repo health, license and activity'],
			['/v1/enrich/android/{pkg}', 'Trackers, permissions, de-Googled support'],
			['/v1/enrich/ios/{bundleId}', 'Version, size and reviews'],
			['/v1/enrich/docker/{name}', 'Image tags and pull stats'],
			['/v1/enrich/website', 'Hosting, DNS and security posture'],
			['/v1/enrich/discord/{invite}', 'Server size and activity'],
		],
	},
];

const source = 'https://github.com/Lissy93/awesome-privacy/tree/main/api';
---

<Layout
	title="API | Awesome Privacy"
	description="A free, no-auth, CORS-enabled REST API for browsing Awesome Privacy's data programmatically, plus enrichment endpoints for trackers, audits and repo health."
	breadcrumbs={[{ name: 'API', item: 'api' }]}
>
	<Main>
		<div class="api-page">
			<h1 class="page-title">API</h1>
			<p class="intro">
				Every listing on Awesome Privacy is available through our REST API.
				Browse categories, sections and services, and use the enrichment
				endpoints to get additional context.
			</p>
			<p class="intro">
				The API is used to power this website, as well as the weekly listing
				audit and run some preliminary checks on new PRs.
			</p>

			<div class="links">
				<a class="primary" href={`${apiBase}/docs`}>Read the docs</a>
				<a href={source}>View source</a>
			</div>

			<div class="example" role="group" aria-label="Example requests">
				{
					examples.map((_, index) => (
						<input
							type="radio"
							name="example"
							id={`example-${index}`}
							checked={index === 0}
						/>
					))
				}
				<div class="tabs">
					{
						examples.map(({ label }, index) => (
							<label for={`example-${index}`}>{label}</label>
						))
					}
				</div>
				<div class="panels">
					{
						examples.map(({ path, response }) => (
							<div class="panel">
								<div class="request">
									<span class="method">GET</span>
									<a href={apiBase + path}>{apiBase + path}</a>
								</div>
								<pre>{response}</pre>
							</div>
						))
					}
				</div>
			</div>

			<div class="endpoints">
				{
					endpoints.map((group) => (
						<section>
							<h2>{group.title}</h2>
							<ul>
								{group.routes.map(([path, summary]) => (
									<li>
										<code>{path}</code>
										<span>{summary}</span>
									</li>
								))}
							</ul>
						</section>
					))
				}
			</div>
		</div>
	</Main>
</Layout>

<style lang="scss">
	$tab-count: 3;

	.api-page {
		max-width: 45rem;
		margin: 0 auto;
		padding-bottom: var(--space-md);
	}

	.intro {
		font-size: var(--text-md);
		opacity: var(--opacity-subtle);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-md);
		font-family: var(--font-subtitle);
		a {
			color: var(--accent-3-text);
			&:hover {
				color: var(--accent-text);
			}
		}
		.primary {
			padding: var(--space-sm) var(--space-md);
			border: var(--border-light);
			border-radius: var(--curve-pill);
			box-shadow: var(--shadow-sm);
			background: var(--accent);
			color: var(--accent-fg);
			font-weight: bold;
			text-decoration: none;
			transition: var(--transition-normal);
			&:hover {
				box-shadow: var(--shadow-sm-hover);
				color: var(--accent-fg);
			}
		}
	}

	.example {
		margin-top: var(--space-lg);
		border: var(--border-heavy);
		border-radius: var(--curve-sm);
		box-shadow: var(--shadow-md);
		background: var(--background-form);
		overflow: hidden;
		input {
			position: absolute;
			opacity: 0;
			pointer-events: none;
		}
		@media (max-width: 428px) {
			display: none;
		}
	}

	.tabs {
		display: flex;
		border-bottom: var(--border-heavy);
		background: var(--surface);
		label {
			padding: var(--space-sm) var(--space-md);
			border-right: var(--border-light);
			color: var(--foreground);
			opacity: var(--opacity-muted);
			cursor: pointer;
			font-family: var(--font-subtitle);
			font-size: var(--text-sm);
			transition: var(--transition-normal);
			&:hover {
				opacity: 1;
			}
		}
	}

	.panel {
		display: none;
	}

	@for $i from 1 through $tab-count {
		input:nth-of-type(#{$i}):checked ~ .panels .panel:nth-child(#{$i}) {
			display: block;
		}
		input:nth-of-type(#{$i}):checked ~ .tabs label:nth-child(#{$i}) {
			opacity: 1;
			background: var(--accent-3);
			color: var(--accent-3-fg);
			font-weight: bold;
		}
		input:nth-of-type(#{$i}):focus-visible ~ .tabs label:nth-child(#{$i}) {
			outline: 2px solid var(--accent-text);
			outline-offset: -2px;
		}
	}

	.request {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		padding: var(--space-sm) var(--space-md);
		border-bottom: var(--border-light);
		font-family: var(--font-code);
		font-size: var(--text-sm);
		.method {
			padding: 0.1rem var(--space-xs);
			border-radius: var(--curve-sm);
			background: var(--accent-3);
			color: var(--accent-3-fg);
			font-weight: bold;
		}
		a {
			color: var(--foreground);
			overflow-wrap: anywhere;
			&:hover {
				color: var(--accent-text);
			}
		}
	}

	pre {
		margin: 0;
		padding: var(--space-md);
		overflow-x: auto;
		font-family: var(--font-code);
		font-size: var(--text-sm);
	}

	.endpoints {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		gap: var(--space-lg);
		margin-top: var(--space-lg);
		h2 {
			margin: 0 0 var(--space-sm);
			font-size: var(--text-md);
		}
		ul {
			margin: 0;
			padding: 0;
			list-style: none;
		}
		li {
			display: flex;
			flex-direction: column;
			margin-bottom: var(--space-sm);
		}
		code {
			font-family: var(--font-code);
			font-size: var(--text-sm);
			overflow-wrap: anywhere;
		}
		span {
			font-size: var(--text-sm);
			opacity: var(--opacity-muted);
		}
	}
</style>
